# Web Backend Configuration
# Copy this file to .env and edit as needed

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage directory for uploaded images and annotated results
STORAGE_DIR=./storage

# Model files directory (relative to backend/ or absolute path)
# Place your model files here:
#   models/pest_detect.pt     — YOLOv8 pest detection model
#   models/disease_cls.pth    — ResNet disease classification model
#   models/disease_classes.json — Disease class names
MODELS_DIR=../../models

# Override individual model paths if needed
# PEST_DETECT_MODEL=/absolute/path/to/pest_detect.pt
# DISEASE_CLS_MODEL=/absolute/path/to/disease_cls.pth
# DISEASE_CLASSES_JSON=/absolute/path/to/disease_classes.json

# Inference thresholds
PEST_CONF_THRESHOLD=0.5
DISEASE_CONF_THRESHOLD=0.5
HEALTHY_THRESHOLD=0.8

# Batch processing
MAX_BATCH_SIZE=50
MAX_WORKERS=2

# SQLite database path
DATABASE_URL=sqlite:///./history.db
